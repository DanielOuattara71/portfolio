# Production .env — imported into the three Vercel projects (web, API, admin).
# Every line is a PLACEHOLDER — replace the values before importing.
# Copy this file to `/tmp/.env.production`, fill values, then import per project:
#   vercel env import /tmp/.env.production production   (in each project)

# --- Database ---
# Use your Neon pooled connection string INCLUDING sslmode.
DATABASE_URL=postgresql://USER:PASSWORD@ep-silent-feather-b6ikvfuu-pooler.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# --- Public site ---
NUXT_PUBLIC_SITE_URL=https://portfolio-web-<slug>.vercel.app
NUXT_PUBLIC_API_BASE=https://portfolio-api-<slug>.vercel.app
NUXT_PUBLIC_SHOW_PLACEHOLDERS=false
NUXT_PUBLIC_SENTRY_DSN=

# --- API ---
NODE_ENV=production
API_PORT=8787
ALLOWED_ORIGINS=https://portfolio-web-<slug>.vercel.app

# Auth (already chain: BETTER_AUTH_SECRET = >=32 chars random; the same for signing cookies.)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://portfolio-admin-<slug>.vercel.app

# --- Media ---
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_PUBLIC_BASE_URL=https://res.cloudinary.com/<cloud-name>

# --- Admin proxy (same value in portfolio-admin AND portfolio-api) ---
ADMIN_API_ORIGIN=https://portfolio-api-<slug>.vercel.app
ADMIN_PROXY_SECRET=

# --- Revalidation (site ↔ API shared secret) ---
NUXT_REVALIDATE_TOKEN=
SITE_REVALIDATE_URL=https://portfolio-web-<slug>.vercel.app/api/_revalidate
REVALIDATE_TOKEN=

# --- Email ---
RESEND_API_KEY=
MAIL_FROM=Portfolio <noreply@<your-domain.com>>

# --- Monitoring & backups ---
BACKUP_ENCRYPTION_KEY=
SENTRY_DSN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=
# Optional — Redis for shared rate-limits (can stay empty for the first launch)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin tracking Neon (optional) ---
# Nothing needed by default.
