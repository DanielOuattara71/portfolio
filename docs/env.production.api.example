# Production .env — IMPORT ONLY TO THE API PROJECT (`portfolio-api`).
# Copy this file to `/tmp/.env-production-api`, fill values marked <...>, then import:
#   vercel link            # choose the repository root "apps/api"
#   vercel env import /tmp/.env-production-api production

# --- API ---
NODE_ENV=production
API_PORT=8787
ALLOWED_ORIGINS=https://portfolio-web-<slug>.vercel.app

# --- Database ---
# Use your Neon connection string INCLUDING sslmode (and NEVER commit it).
DATABASE_URL=postgresql://USER:PASSWORD@ep-silent-feather-b6ikvfuu-pooler.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# --- Media (Cloudinary, régénérés par vous) ---
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=<value>
CLOUDINARY_API_KEY=<value>
CLOUDINARY_API_SECRET=<value>
MEDIA_PUBLIC_BASE_URL=https://res.cloudinary.com/<cloud-name>

# --- Auth ---
BETTER_AUTH_SECRET=<openssl rand -base64 48>   # identical in admin and API
# URL où l'admin se connectera (le cookie session est sur l'admin)
BETTER_AUTH_URL=https://portfolio-admin-<slug>.vercel.app

# --- Admin proxy ---
ADMIN_PROXY_SECRET=<openssl rand -hex 32>       # identical in admin and API

# --- Revalidation (API → site) ---
SITE_REVALIDATE_URL=https://portfolio-web-<slug>.vercel.app/api/_revalidate
REVALIDATE_TOKEN=<same value as NUXT_REVALIDATE_TOKEN side web>

# --- Monitoring & backups ---
BACKUP_ENCRYPTION_KEY=<openssl rand -base64 32>
SENTRY_DSN=<value>
QSTASH_CURRENT_SIGNING_KEY=<value>
QSTASH_NEXT_SIGNING_KEY=<value>
QSTASH_TOKEN=<value>
UPSTASH_REDIS_REST_URL=<value>    # optional; remove if you are not using Redis
UPSTASH_REDIS_REST_TOKEN=<value>  # optional; remove if you are not using Redis

# --- Email ---
RESEND_API_KEY=<value>
MAIL_FROM=Portfolio <noreply@<your-domain.com>>
