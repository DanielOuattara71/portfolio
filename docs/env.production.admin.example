# Production .env — IMPORT ONLY TO THE ADMIN PROJECT (`portfolio-admin`).
# Copy this file to `/tmp/.env-production-admin`, fill values marked <...>, then import:
#   vercel link            # choose the repository root "apps/admin"
#   vercel env import /tmp/.env-production-admin production

# --- Admin site ---
NODE_ENV=production
ADMIN_API_ORIGIN=https://portfolio-api-<slug>.vercel.app
ADMIN_PROXY_SECRET=<openssl rand -hex 32>   # identical value in admin and API
BETTER_AUTH_SECRET=<openssl rand -base64 48>  # identical value in admin and API
NUXT_PUBLIC_SITE_URL=https://portfolio-web-<slug>.vercel.app   # used by "Voir le site" link in sidebar
NUXT_PUBLIC_SENTRY_DSN=<value>
