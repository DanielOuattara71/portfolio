# Production .env — IMPORT ONLY TO THE WEB PROJECT (`portfolio-web`).
# Copy this file to `/tmp/.env-production-web`, fill values marked <...>, then import:
#   vercel link            # choose the repository root "apps/web" ("Portfolio Web")
#   vercel env import /tmp/.env-production-web production

# --- Public site ---
NUXT_PUBLIC_SITE_URL=https://portfolio-web-<slug>.vercel.app
NUXT_PUBLIC_API_BASE=https://portfolio-api-<slug>.vercel.app
NUXT_PUBLIC_SHOW_PLACEHOLDERS=false
NUXT_PUBLIC_SENTRY_DSN=<value>    # Sentry DSN (same value as SENTRY_DSN côté API)

# --- revalidation (API → site shared secret) ---
NUXT_REVALIDATE_TOKEN=<openssl rand -hex 32>
