{
  "name": "portfolio",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@portfolio/web",
    "dev:api": "turbo run dev --filter=@portfolio/api",
    "dev:admin": "turbo run dev --filter=@portfolio/admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "tokens": "pnpm --filter @portfolio/design-tokens build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
