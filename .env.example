# Copy to .env and fill in. Never commit .env.

# --- Database (local Docker values; production uses the Neon URL set in Vercel) ---
DATABASE_URL=postgres://portfolio:portfolio_dev@localhost:5432/portfolio

# --- Public site (apps/web) ---
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_API_BASE=http://localhost:8787
# Review mode: show "to provide" media and link placeholders. Never true in production.
NUXT_PUBLIC_SHOW_PLACEHOLDERS=true
# Shared secret with the API for on-demand refresh after a publication (POST /api/_revalidate).
NUXT_REVALIDATE_TOKEN=

# --- API (apps/api) ---
API_PORT=8787
# Origins allowed to call /public/* (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Authentication (API). Secret: 32+ random characters (openssl rand -base64 48). URL: the admin origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002
# Media storage. "local" (development, files in apps/api/.storage) or "cloudinary" (production).
MEDIA_STORAGE=local
# Base URL of public media files. Local: the API itself (/media/*). Cloudinary: the res.cloudinary.com delivery base.
MEDIA_PUBLIC_BASE_URL=http://localhost:8787
# Cloudinary only (dashboard > Settings > API Keys). PDF delivery of raw files requires
# Settings > Security > "PDF and ZIP files delivery" enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Backups: separate "backups" prefix in the same Cloudinary cloud (raw resources, signed Admin API).
BUCKET_BACKUP_PREFIX=backups
# Backup encryption key: 32 bytes, base64 (openssl rand -base64 32) or 64 hex chars.
# Without it backups are unreadable: keep it in your password manager too (docs/admin/06).
BACKUP_ENCRYPTION_KEY=
BACKUP_LOCAL_DIR=
# Monitoring: Upstash QStash calls POST /internal/checks (5 min), /internal/backup and
# /internal/maintenance (daily). Signing keys come from the Upstash dashboard; QSTASH_TOKEN is
# the dev/fallback bearer token. Local dev script: pnpm --filter @portfolio/api internal -- checks
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=
# Error reporting: site, admin and API. No IP or personal data is sent (docs/admin/05 §C).
# Empty in development: Sentry stays silent.
SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
# Email (password reset, alerts, new sign-in notifications). Empty in development: printed in the API console.
RESEND_API_KEY=
MAIL_FROM=
# On-demand refresh: URL of the site _revalidate endpoint + shared secret (same value as NUXT_REVALIDATE_TOKEN).
SITE_REVALIDATE_URL=
REVALIDATE_TOKEN=

# --- Admin (apps/admin, http://localhost:3002) ---
# API reached through the admin /api/** proxy (same-origin session cookie)
ADMIN_API_ORIGIN=http://localhost:8787
# Shared by the admin proxy and the API (openssl rand -hex 32): the API refuses /api/* without it.
ADMIN_PROXY_SECRET=
